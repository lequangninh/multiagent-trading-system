# Copy to .env (git-ignored). Values here are placeholders and are refused at startup.
# Empty values mean "not set". Never commit .env.

# PostgreSQL password for the local docker compose stack. docker compose reads this
# file too, so the database and the app always agree. An existing pgdata volume keeps
# the password it was initialised with; change it only by recreating the volume.
POSTGRES_PASSWORD=changeme

# Binance Spot Testnet keys, required for paper mode only. Generated at
# https://testnet.binance.vision (GitHub login). Never live keys.
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# Optional: alert webhook (http/https URL receiving JSON POSTs).
SWARM_ALERT_WEBHOOK=

# Optional: reserved for a real sentiment provider. Not read by any shipped code path.
SWARM_LLM_API_KEY=
