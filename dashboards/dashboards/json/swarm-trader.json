{
  "uid": "swarm-trader",
  "title": "Swarm Trader (paper)",
  "tags": [
    "swarm-trader",
    "paper"
  ],
  "timezone": "utc",
  "editable": false,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {
      "id": 1,
      "title": "Equity curve (USDT)",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescale"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 16,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescale"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT ts AS time, equity, cash, inventory_value FROM equity_snapshots WHERE $__timeFilter(ts) ORDER BY ts"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "options": {},
      "description": "Marked equity written by the OMS on every reconcile cycle."
    },
    {
      "id": 2,
      "title": "Daily drawdown",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescale"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescale"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT (first(equity, ts) - last(equity, ts)) / first(equity, ts) * 100 AS drawdown_pct FROM equity_snapshots WHERE ts >= date_trunc('day', now() AT TIME ZONE 'UTC') AT TIME ZONE 'UTC'"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none"
      },
      "description": "UTC-day drawdown from first to latest equity snapshot. Alert at 2%, risk veto at 3%."
    },
    {
      "id": 3,
      "title": "Feed lag (s)",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescale"
      },
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescale"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT symbol, EXTRACT(EPOCH FROM now() - max(ts)) AS lag_s FROM book_snapshots GROUP BY symbol ORDER BY symbol"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 60
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/lag_s/",
          "values": true
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "description": "Seconds since the last stored book snapshot per symbol. Alert fires above 60s."
    },
    {
      "id": 4,
      "title": "Orders by status (range)",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescale"
      },
      "gridPos": {
        "x": 16,
        "y": 4,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescale"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT payload->>'status' AS status, count(*)::int AS orders FROM orders WHERE $__timeFilter(ts) GROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/orders/",
          "values": true
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value_and_name"
      }
    },
    {
      "id": 5,
      "title": "Open positions",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescale"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescale"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT p.symbol, p.quantity, c.close AS last_price, p.quantity * c.close AS value_usdt, p.ts AS updated FROM positions p LEFT JOIN LATERAL (SELECT close FROM candles WHERE symbol = p.symbol AND timeframe = '1m' ORDER BY ts DESC LIMIT 1) c ON true ORDER BY p.symbol"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "description": "Exchange-reconciled holdings valued at the latest stored 1m close."
    },
    {
      "id": 6,
      "title": "Per-agent hit rate, 30 min horizon (range)",
      "type": "bargauge",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescale"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescale"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT v.agent,\n       round(100.0 * avg(CASE WHEN sign(later.close - entry.close) = (v.signal->>'direction')::int\n                              THEN 1 ELSE 0 END), 1) AS hit_rate_pct,\n       count(*)::int AS votes\nFROM votes v\nJOIN LATERAL (SELECT close FROM candles c WHERE c.symbol = v.symbol AND c.timeframe = '1m'\n              AND c.ts <= v.ts ORDER BY c.ts DESC LIMIT 1) entry ON true\nJOIN LATERAL (SELECT close FROM candles c WHERE c.symbol = v.symbol AND c.timeframe = '1m'\n              AND c.ts >= v.ts + interval '30 minutes' ORDER BY c.ts LIMIT 1) later ON true\nWHERE (v.signal->>'direction')::int <> 0 AND $__timeFilter(v.ts)\nGROUP BY v.agent ORDER BY v.agent"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 45
              },
              {
                "color": "green",
                "value": 55
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/hit_rate_pct/",
          "values": true
        },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true
      },
      "description": "Share of directional votes whose sign matched the 1m close move 30 minutes later. Filters (direction 0) excluded."
    },
    {
      "id": 7,
      "title": "Risk rejections by reason (range)",
      "type": "barchart",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescale"
      },
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescale"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT reason, count(*)::int AS rejections FROM risk_decisions WHERE verdict = 'REJECT' AND $__timeFilter(ts) GROUP BY reason ORDER BY 2 DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "xField": "reason",
        "showValue": "always",
        "legend": {
          "showLegend": false
        }
      },
      "description": "Authoritative OMS-side gate verdicts. Every REJECT carries its rule name."
    },
    {
      "id": 8,
      "title": "Risk verdicts over time (range)",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescale"
      },
      "gridPos": {
        "x": 12,
        "y": 15,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescale"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT $__timeGroupAlias(ts, 1h), verdict AS metric, count(*)::int AS decisions FROM risk_decisions WHERE $__timeFilter(ts) GROUP BY 1, 2 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 9,
      "title": "Book snapshots per minute (range)",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescale"
      },
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescale"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT $__timeGroupAlias(ts, 1m), symbol AS metric, count(*)::int AS snapshots FROM book_snapshots WHERE $__timeFilter(ts) GROUP BY 1, 2 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "description": "Gaps show as missing bars: the feed was down or the Mac was asleep."
    },
    {
      "id": 10,
      "title": "LLM cost per day, estimated (range)",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescale"
      },
      "gridPos": {
        "x": 12,
        "y": 22,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescale"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT $__timeGroupAlias(ts, 1d), CASE WHEN is_mock THEN 'mock' ELSE 'real' END AS metric, sum(estimated_cost_usd) AS usd FROM llm_calls WHERE $__timeFilter(ts) GROUP BY 1, 2 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 4,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60
          }
        },
        "overrides": []
      },
      "options": {},
      "description": "Estimated from characters/4 x configured list price in config/sentiment.yaml."
    },
    {
      "id": 11,
      "title": "Alerts and events (range)",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescale"
      },
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescale"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT ts, kind, symbol, detail FROM events WHERE $__timeFilter(ts) ORDER BY ts DESC LIMIT 200"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "description": "alert = monitor fired (feed_stale, daily_drawdown, agent_exceptions, reconcile_discrepancy); other kinds are raw events."
    }
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": [
      {
        "name": "Alerts",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "timescale"
        },
        "enable": true,
        "iconColor": "red",
        "target": {
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT ts AS time, kind || ': ' || detail AS text, kind AS tags FROM events WHERE kind = 'alert' AND $__timeFilter(ts)"
        }
      }
    ]
  }
}